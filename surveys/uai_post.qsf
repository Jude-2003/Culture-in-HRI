loped feelings."},"3":{"Display":"I feel comfortable being with robots that have emotions."},"4":{"Display":"I would feel nervous operating a robot in front of other people."},"5":{"Display":"I would hate the idea that robots or AI might make decisions that affect my life."},"6":{"Display":"I would feel very nervous if I had to interact with a robot."},"7":{"Display":"I dislike robots that pretend to have emotions."},"8":{"Display":"I feel relaxed talking with robots."},"9":{"Display":"I feel ill at ease with robots that try to express emotions."}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":20,"NextAnswerId":24,"Answers":{"1":{"Display":"Strongly disagree"},"2":{"Display":"Somewhat disagree"},"3":{"Display":"Neither agree nor disagree"},"4":{"Display":"Somewhat agree"},"5":{"Display":"Strongly agree"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false}},{"SurveyID":"SV_1Y6wTl2Ejejfuaa","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}